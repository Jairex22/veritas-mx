# FactoryLogix Knowledge Copilot - variables de entorno (EJEMPLO, SIN SECRETOS)
# Copia este archivo como ".env" en la misma carpeta y completa SOLO lo necesario.
# ".env" nunca debe subirse a repositorios ni incluirse en el ZIP.

# Entorno: DEMO | PILOT | PRODUCTION
FLKC_ENVIRONMENT=DEMO
# local = solo este equipo (127.0.0.1) | network = red interna (0.0.0.0)
FLKC_BIND=local
FLKC_PORT=8501
# Cargar datos/usuarios DEMO (solo aplica con FLKC_ENVIRONMENT=DEMO)
FLKC_LOAD_DEMO=true
FLKC_CREATE_DEMO_USERS=true

# LLM local opcional: none | ollama | llamacpp (solo hosts locales/red privada)
FLKC_LLM_PROVIDER=none
FLKC_LLM_BASE_URL=http://127.0.0.1:11434
FLKC_LLM_MODEL=llama3.1:8b

# Embeddings: hashing (incluido) | sentence_transformers (opcional, modelo local en models_local/)
FLKC_EMBEDDING_PROVIDER=hashing

# Conector OData de FactoryLogix Analytics (solo lectura, desactivado por defecto)
FLKC_ODATA_ENABLED=false
FLKC_ODATA_BASE_URL=
# Credenciales de cuenta de servicio de SOLO LECTURA (usar una de las dos opciones):
FLKC_ODATA_TOKEN=
FLKC_ODATA_USERNAME=
FLKC_ODATA_PASSWORD=

# SMTP interno opcional (el envío también debe habilitarse en settings.yaml y confirmarse en pantalla)
FLKC_SMTP_USERNAME=
FLKC_SMTP_PASSWORD=

# Rutas alternativas (opcional)
# FLKC_DATA_DIR=data
# FLKC_DATABASE=data/copilot.db
