<?xml version="1.0" encoding="utf-8"?>
<!-- Plantilla IIS (ASP.NET Core Module V2, in-process). Requiere el Hosting Bundle de .NET 10 en el servidor. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\GPV.ProductTimeFlow.Web.dll" stdoutLogEnabled="false" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!-- Secretos: definir en el App Pool / variables del sistema, NO aquí. -->
        </environmentVariables>
      </aspNetCore>
      <webSocket enabled="true" />
      <security><requestFiltering removeServerHeader="true"><requestLimits maxAllowedContentLength="12582912" /></requestFiltering></security>
    </system.webServer>
  </location>
</configuration>
