# Variables de entorno de PRODUCCIÓN (ejemplo SIN valores reales). Configúrelas en el servidor o en un almacén seguro.
ASPNETCORE_ENVIRONMENT=Production
TimeFlow__Mode=Production
TimeFlow__PublicBaseUrl=https://timeflow.SU-DOMINIO
TimeFlow__DataRoot=D:/GPV/TimeFlow/Data
Database__Provider=SqlServer
Database__ConnectionString=Server=SQLSERVER;Database=GpvProductTimeFlow;Integrated Security=true;Encrypt=true;TrustServerCertificate=false
Database__AutoMigrate=false
Authentication__Mode=EntraId
AzureAd__TenantId=<id-del-tenant>
AzureAd__ClientId=<id-app-web>
AzureAd__ClientSecret=<secreto-o-usar-certificado>
Email__Provider=Graph
Email__Graph__TenantId=<id-del-tenant>
Email__Graph__ClientId=<id-app-correo>
Email__Graph__CertificatePath=D:/GPV/TimeFlow/certs/timeflow-mail.pfx
Email__Graph__CertificatePassword=<desde-almacén-seguro>
Email__Graph__SenderMailbox=timeflow@SU-DOMINIO
