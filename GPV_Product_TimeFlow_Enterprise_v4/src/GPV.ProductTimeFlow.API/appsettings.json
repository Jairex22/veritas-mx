{
  "TimeFlow": {
    "Mode": "Demo",
    "PublicBaseUrl": "https://localhost:7101",
    "TimeZoneId": "America/Mexico_City",
    "DataRoot": "../../App_Data"
  },
  "Database": {
    "Provider": "Sqlite",
    "AutoMigrate": true
  },
  "Authentication": {
    "Mode": "LocalDemo",
    "Jwt": {
      "Issuer": "gpv-product-timeflow",
      "Audience": "gpv-product-timeflow-clients",
      "LifetimeMinutes": 480
    }
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "Audience": ""
  },
  "Email": {
    "Provider": "Mock",
    "ProcessorEnabled": false
  },
  "Demo": {
    "SyntheticEmployees": 200,
    "SeedSampleRequests": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
