@implements IDisposable
@inject AuthState Auth
@inject NotificationCenter Notifications
@inject NavigationManager Nav

@if (!Auth.IsInitialized)
{
    <div class="boot" role="status" aria-live="polite">
        <div class="brand-mark brand-mark-lg" aria-hidden="true"></div>
        <p>Cargando GPV TimeFlow…</p>
    </div>
}
else
{
    <Router AppAssembly="typeof(Routes).Assembly" NotFoundPage="typeof(Pages.NotFoundPage)">
        <Found Context="routeData">
            @if (Auth.IsAuthenticated || PublicPageAttribute.IsPublic(routeData.PageType))
            {
                @* @key = URL: cada navegación (incluido un cambio de filtros en la query) crea una instancia nueva de la página. *@
                <RouteView @key="Nav.Uri" RouteData="routeData" DefaultLayout="typeof(MainLayout)" />
                <FocusOnNavigate RouteData="routeData" Selector="h1" />
            }
            else
            {
                <RedirectToLogin />
            }
        </Found>
    </Router>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        Auth.Changed += OnAuthChanged;
        await Auth.InitializeAsync();
        // NotificationCenter se suscribe a AuthState al construirse; aquí se sincroniza con la sesión restaurada.
        await Notifications.SyncWithSessionAsync();
    }

    private void OnAuthChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Auth.Changed -= OnAuthChanged;
}
