{
  "TimeFlow": {
    "Mode": "Demo",
    "PublicBaseUrl": "https://localhost:7101",
    "TimeZoneId": "America/Mexico_City",
    "DataRoot": "../../App_Data"
  },
  "Database": {
    "Provider": "Sqlite",
    "AutoMigrate": true
  },
  "Authentication": {
    "Mode": "LocalDemo"
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  },
  "Email": {
    "Provider": "Mock",
    "ProcessorEnabled": true,
    "PollSeconds": 10,
    "MaxAttempts": 6,
    "BrandColor": "#1F4FD8",
    "RemindersEnabled": true,
    "ReminderIntervalMinutes": 60,
    "Graph": {
      "TenantId": "",
      "ClientId": "",
      "SenderMailbox": "",
      "SaveToSentItems": true
    }
  },
  "Demo": {
    "SyntheticEmployees": 200,
    "SeedSampleRequests": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
