# Copia este archivo a .env y completa los valores. Nunca subas .env real
# a un repositorio ni lo compartas: contiene secretos.

PORT=8787

# Carpeta donde vive el archivo SQLite persistente (por defecto server/data).
# DATA_DIR=./data

# Secreto para firmar los tokens de sesión del panel del dueño. Genera uno
# propio y único por instalación, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Credencial de OpenAI para el motor de IA conversacional. Si se deja vacío,
# el asistente sigue funcionando (catálogo, cotizaciones, citas, contacto)
# pero la conversación libre usa un motor de respaldo determinista y el
# panel del dueño mostrará "IA pendiente de configurar".
OPENAI_API_KEY=

# Modelo a usar con la Responses API de OpenAI. Configurable sin tocar código.
OPENAI_MODEL=gpt-4.1-mini

# Orígenes permitidos para peticiones al API separados por coma (recomendado
# en producción). Si se deja vacío, se permite cualquier origen (útil en
# desarrollo local).
# CORS_ORIGIN=https://tu-dominio.com,https://panel.tu-dominio.com
