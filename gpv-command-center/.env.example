# ======================================================================
# GPV FactoryLogix Command Center — configuración del SERVIDOR
# Copie este archivo como .env (NO lo suba al repositorio).
# Las credenciales sólo se leen en el servidor; nunca llegan al navegador.
# ======================================================================

# DEMO = datos sintéticos + operaciones simuladas | REAL = sólo fuentes reales
GPV_MODE=DEMO
GPV_DEMO_LOGIN_ENABLED=true

# Directorio de datos propios (SQLite, logs, llave de firma). Respaldar.
# GPV_DATA_DIR=D:\GPVCommandCenter\var
# GPV_CONFIG_DIR=D:\GPVCommandCenter\config

# Sesiones
GPV_SESSION_TTL_MIN=480
# Poner true cuando se sirva por HTTPS (recomendado en producción)
GPV_COOKIE_SECURE=false
# Llave de firma (opcional). Si no se define se genera var/secret.key
# GPV_SECRET_KEY=

# --- Autenticación corporativa (IIS + Autenticación de Windows como proxy inverso) ---
# Encabezado con la identidad que IIS envía (vacío = deshabilitado) y IPs del proxy de confianza.
# GPV_PROXY_AUTH_HEADER=X-Remote-User
# GPV_PROXY_AUTH_TRUSTED_IPS=127.0.0.1,::1
# GPV_USER_ROLES_FILE=user_roles.json

# Fuente de datos en modo REAL: none | odata | aux
GPV_REAL_DATA_SOURCE=none

# --- OData (sólo lectura) ---
# GPV_ODATA_BASE_URL=https://<servidor-factorylogix>/<ruta-odata>
# GPV_ODATA_AUTH=basic          # basic | bearer | ntlm (requiere pip install httpx-ntlm) | none
# GPV_ODATA_USERNAME=
# GPV_ODATA_PASSWORD=
# GPV_ODATA_TOKEN=
# GPV_ODATA_MAPPING_FILE=odata_mapping.json

# --- xTend API / FactoryLogixAPI (sólo prueba de alcance en v1.0) ---
# GPV_XTEND_BASE_URL=
# GPV_FLX_API_BASE_URL=

# --- Fuentes auxiliares (CSV/XML) ---
# GPV_AUX_DIR=D:\FactoryLogixExports

# --- Red ---
GPV_HTTP_TIMEOUT=10
GPV_VERIFY_TLS=true
# GPV_CA_BUNDLE=C:\certs\ca-corporativa.pem

# Interruptor maestro de escrituras en producción. En v1.0 NO existe ningún
# ejecutor real; aunque se active, toda acción real responde NO DISPONIBLE.
GPV_ALLOW_PRODUCTION_WRITES=false
