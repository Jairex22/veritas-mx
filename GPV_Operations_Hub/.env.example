# GPV Operations Hub — configuración de ejemplo. Copie este archivo como ".env" y ajuste los valores.
# NO guarde claves reales en el ZIP ni en repositorios.

# Perfil: dev (local/demostración) o prod (uso compartido interno)
GPV_ENV=dev

# Clave secreta. Obligatoria en prod. Genérela con:  .venv\Scripts\python.exe manage.py gpv_genkey
# En dev, si se deja vacía, se genera una aleatoria en data\dev_secret_key.txt
GPV_SECRET_KEY=

# Hosts permitidos (separados por coma) y orígenes de confianza para CSRF (con https:// en producción)
GPV_ALLOWED_HOSTS=127.0.0.1,localhost
GPV_CSRF_TRUSTED_ORIGINS=

# Carpeta de datos (base SQLite, archivos privados, respaldos, logs). Fuera de recursos públicos.
# GPV_DATA_DIR=C:\GPV\data

# Base de datos: sqlite (demostración / uso reducido) o postgresql (multiusuario)
GPV_DB_ENGINE=sqlite
# GPV_DB_NAME=gpvhub
# GPV_DB_USER=gpvhub
# GPV_DB_PASSWORD=
# GPV_DB_HOST=localhost
# GPV_DB_PORT=5432

# Trabajos: inline (demo: se ejecutan dentro de la solicitud) o worker (requiere manage.py run_worker activo)
GPV_JOBS_MODE=inline

# Datos de demostración (seed_demo). Mantener en false en producción.
GPV_ALLOW_DEMO=true

# Intervalo de actualización de notificaciones en segundos
GPV_POLL_SECONDS=30

# Límites
GPV_MAX_UPLOAD_MB=50
GPV_IMPORT_MAX_ROWS=500000
GPV_IMPORT_CHUNK_ROWS=2000
GPV_SHEET_MAX_CELLS=300000

# Convertidor Office (opcional). Ruta a soffice.exe de LibreOffice instalado por TI.
# GPV_SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
GPV_SOFFICE_TIMEOUT=120
# OCR opcional (Tesseract)
# GPV_TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# Impresoras: tiempo máximo de conexión/envío en segundos
GPV_PRINTER_TIMEOUT=8

# Producción detrás de proxy HTTPS
# GPV_SECURE_COOKIES=true
# GPV_BEHIND_TLS_PROXY=true
# GPV_HSTS_SECONDS=0

# ---------------------------------------------------------------- Portal del turno · FactoryLogix OData (solo lectura)
# La URL, el conjunto de entidades y el mapeo se registran en Administración (POR CONFIRMAR con GPV); NO se inventan.
# Las credenciales NUNCA se guardan en la base de datos ni en este archivo de ejemplo: defínalas solo en el equipo
# autorizado como variables de entorno del usuario de Windows que ejecuta el portal (ver CONFIGURACION_ODATA.md):
#   setx GPV_ODATA_USER "..."      setx GPV_ODATA_PASSWORD "..."      (o un token en la variable que se configure)
# No se usan credenciales de Windows automáticamente ni se supone acceso anónimo.

# ---------------------------------------------------------------- FactoryLogix OData (GPV Operations HUB 2.0, solo lectura)
# Servicio autorizado por GPV (red interna). Los usuarios del portal NO pueden cambiar esta dirección.
GPV_FLX_BASE_URL=http://10.62.54.10:6065/odata/
# auto = solo detecta qué autenticación pide el servidor (no envía credenciales).
# Después del diagnóstico elija: none | basic | negotiate (Windows integrada, Kerberos/NTLM con la sesión actual) | ntlm (usuario de servicio)
GPV_FLX_AUTH=auto
# Credenciales (solo basic/ntlm): defínalas como variables de entorno del usuario de Windows, NUNCA en este archivo:
#   setx GPV_FLX_USER "DOMINIO\usuario_servicio"
#   setx GPV_FLX_PASSWORD "********"
GPV_FLX_TIMEOUT=20
GPV_FLX_MAX_TOP=200
GPV_FLX_MAX_ROWS=1000
GPV_FLX_MAX_PAGES=10
GPV_FLX_CACHE_SECONDS=30
GPV_FLX_CONCURRENCY=3
GPV_FLX_PROBE_DELAY_MS=500
GPV_FLX_BREAKER_FAILURES=5
GPV_FLX_BREAKER_COOLDOWN=120
# El servidor es interno: por omisión NO se usa el proxy del sistema. Cambie a true solo si TI lo indica.
GPV_FLX_USE_SYSTEM_PROXY=false
