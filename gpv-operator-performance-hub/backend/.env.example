# ============================================================================
# GPV Operator Performance Hub — variables de entorno del backend
# Copia este archivo como ".env" (en la misma carpeta backend/) y ajusta los
# valores. NUNCA subas el archivo ".env" real a un repositorio ni compartas
# credenciales reales por este medio de forma insegura.
# ============================================================================

# --- General ---
APP_NAME=GPV Operator Performance Hub
PLANT_NAME=Planta Querétaro - GPV
ENVIRONMENT=demo
APP_TIMEZONE=America/Mexico_City

# --- Base de datos ---
# Demo (SQLite, no requiere configuración adicional):
DATABASE_URL=sqlite:///./veritas_mx.db
# Producción (SQL Server, requiere pyodbc y el driver ODBC instalado):
# DATABASE_URL=mssql+pyodbc://usuario:password@servidor/GPV_MES?driver=ODBC+Driver+17+for+SQL+Server

# --- Seguridad / sesiones ---
# Genera un valor aleatorio largo y único por ambiente (nunca reutilices el de este ejemplo).
JWT_SECRET=CAMBIA-ESTE-VALOR-EN-PRODUCCION
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- CORS (orígenes permitidos del frontend, separados por coma) ---
CORS_ORIGINS=http://localhost:5173

# --- Datos simulados ---
USE_SIMULATED_DATA=true
SEED_RANDOM_STATE=2026

# ============================================================================
# Conector FactoryLogix Analytics (OData + autenticación Basic)
# Déjalo en FACTORYLOGIX_ENABLED=false mientras no tengas URL/usuario/clave
# autorizados por tu equipo de IT/MES. La aplicación funciona con datos
# simulados sin esta sección.
# ============================================================================
FACTORYLOGIX_ENABLED=false
# URL base del servicio OData de FactoryLogix Analytics (SIN barra final), p.ej.:
# FACTORYLOGIX_BASE_URL=https://servidor-factorylogix.tuempresa.com/AnalyticsOData
FACTORYLOGIX_BASE_URL=
FACTORYLOGIX_USERNAME=
FACTORYLOGIX_PASSWORD=
FACTORYLOGIX_TIMEOUT_SECONDS=15
FACTORYLOGIX_MAX_RETRIES=2

# Nombres de entidad OData (ajusta si tu instalación los expone distinto;
# ver MANUAL_FACTORYLOGIX.md).
FLX_ENTITY_PRODUCTION_ACTIVITY=ProductionActivity
FLX_ENTITY_UNIT_HISTORY=UnitHistory
FLX_ENTITY_WIP=WIP
FLX_ENTITY_ACTIVE_TRACKING=ActiveProductTracking
FLX_ENTITY_ACTIVE_TRACKING_DETAIL=ActiveProductTrackingDetail
FLX_ENTITY_QUALITY=Quality
FLX_ENTITY_FAULTS=Faults
FLX_ENTITY_VALIDATION_EXCEPTIONS=ValidationExceptions
FLX_ENTITY_NON_CONFORMANCE=NonConformance
FLX_ENTITY_USER_CERTIFICATION=UserCertification
FLX_ENTITY_TEST_MEASUREMENT=TestAndMeasurement
FLX_ENTITY_WORK_ORDERS=WorkOrders
FLX_ENTITY_STATIONS=Stations
FLX_ENTITY_PRODUCTS=Products
FLX_ENTITY_USERS=Users

# --- Motor de puntaje (pesos iniciales; también editable desde Configuración) ---
SCORE_WEIGHT_QUALITY=0.35
SCORE_WEIGHT_CYCLE=0.25
SCORE_WEIGHT_PRODUCTIVITY=0.20
SCORE_WEIGHT_CONSISTENCY=0.10
SCORE_WEIGHT_REWORK=0.10
SCORE_MIN_UNITS=20
